# ── iChart environment (GenLayer-only edition) ────────────────────────
# Copy to `.env` and fill in. Keys live ONLY on the server.

# GenLayer account (EOA private key) used to submit analyze() transactions.
# Generate one and import it into the CLI:
#   genlayer account import --name ichart --private-key <0x...>
GENLAYER_PRIVATE_KEY=

# IChartAnalyst contract address (deploy genlayer/contracts/ichart_analyst.py)
GENLAYER_CONTRACT_ADDRESS=

# Network: studionet (gasless) | testnet-bradbury (needs faucet GEN)
GENLAYER_NETWORK=studionet

# Port for the API server (Vite dev server proxies /api here)
PORT=8787
